using System;

namespace UnitConverter
{
    class Program
    {
        const double KmToMilesFactor = 1.609344;
        const double KgToLbsFactor = 0.45359237;
        const double AbsoluteZeroC = -273.15;
        const double AbsoluteZeroF = -459.67;

        static void Main()
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;

            while (true)
            {
                Console.WriteLine("\n=== Конвертер величин ===");
                Console.WriteLine("1. км → милі");
                Console.WriteLine("2. милі → км");
                Console.WriteLine("3. кг → фунти");
                Console.WriteLine("4. фунти → кг");
                Console.WriteLine("5. °C → °F");
                Console.WriteLine("6. °F → °C");
                Console.WriteLine("0. Вихід");
                Console.Write("Оберіть напрямок (0-6): ");

                string choice = Console.ReadLine();

                if (choice == "0")
                {
                    Console.WriteLine("Роботу завершено.");
                    break;
                }

                double input;
                switch (choice)
                {
                    case "1":
                        input = GetValidInput("км", 0);
                        if (!double.IsNaN(input))
                            Console.WriteLine($"{input:F2} км = {KmToMiles(input):F2} милі");
                        break;

                    case "2":
                        input = GetValidInput("милі", 0);
                        if (!double.IsNaN(input))
                            Console.WriteLine($"{input:F2} милі = {MilesToKm(input):F2} км");
                        break;

                    case "3":
                        input = GetValidInput("кг", 0);
                        if (!double.IsNaN(input))
                            Console.WriteLine($"{input:F2} кг = {KgToLbs(input):F2} фунти");
                        break;

                    case "4":
                        input = GetValidInput("фунти", 0);
                        if (!double.IsNaN(input))
                            Console.WriteLine($"{input:F2} фунти = {LbsToKg(input):F2} кг");
                        break;

                    case "5":
                        input = GetValidInput("°C", AbsoluteZeroC);
                        if (!double.IsNaN(input))
                            Console.WriteLine($"{input:F2} °C = {CToF(input):F2} °F");
                        break;

                    case "6":
                        input = GetValidInput("°F", AbsoluteZeroF);
                        if (!double.IsNaN(input))
                            Console.WriteLine($"{input:F2} °F = {FToC(input):F2} °C");
                        break;

                    default:
                        Console.WriteLine("Помилка: невідомий пункт меню. Спробуйте ще раз.");
                        break;
                }
            }
        }

        static double GetValidInput(string unit, double minValue)
        {
            while (true)
            {
                Console.Write($"Введіть значення ({unit}): ");
                string input = Console.ReadLine();

                // Валідація числа
                if (double.TryParse(input, out double value))
                {
                    // Перевірка на фізичну можливість (межові дані)
                    if (value >= minValue)
                    {
                        return value;
                    }

                    Console.WriteLine($"Попередження: значення не може бути меншим за {minValue} {unit}. Спробуйте ще раз.");
                }
                else
                {
                    Console.WriteLine("Помилка: введено некоректне число. Спробуйте ще раз (кома замість крапки).");
                }
            }
        }

        // --- Окремі методи для кожної конвертації ---

        static double KmToMiles(double km) => km / KmToMilesFactor;

        static double MilesToKm(double miles) => miles * KmToMilesFactor;

        static double KgToLbs(double kg) => kg / KgToLbsFactor;

        static double LbsToKg(double lbs) => lbs * KgToLbsFactor;

        static double CToF(double c) => c * 9.0 / 5.0 + 32.0;

        static double FToC(double f) => (f - 32.0) * 5.0 / 9.0;
    }
}

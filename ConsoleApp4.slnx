using System;
using System.Collections.Generic;

namespace ParcelTracker
{
    // === 1. Елементи предметної області ===
    public enum ShipmentStatus
    {
        Created,
        InTransit,
        Arrived,
        Received
    }

    public interface IShipment
    {
        string TrackingNumber { get; }
        decimal WeightKg { get; }
        ShipmentStatus Status { get; set; }
    }

    public class Parcel : IShipment
    {
        public string TrackingNumber { get; }
        public string Recipient { get; }
        public decimal WeightKg { get; }
        public ShipmentStatus Status { get; set; }

        public Parcel(string trackingNumber, string recipient, decimal weightKg)
        {
            TrackingNumber = trackingNumber;
            Recipient = recipient;
            WeightKg = weightKg;
            Status = ShipmentStatus.Created;
        }
    }

    // === 2. Клас EventArgs для події ===
    public class StatusChangedEventArgs<T> : EventArgs
    {
        public T Shipment { get; }
        public ShipmentStatus OldStatus { get; }
        public ShipmentStatus NewStatus { get; }

        public StatusChangedEventArgs(T shipment, ShipmentStatus oldStatus, ShipmentStatus newStatus)
        {
            Shipment = shipment;
            OldStatus = oldStatus;
            NewStatus = newStatus;
        }
    }

    // === 3. Узагальнений клас із делегатами та подією ===
    public class Tracker<T> where T : class, IShipment
    {
        private readonly List<T> _items = new();
        private Func<T, decimal>? _tariff; // Необов'язкове правило (null = за замовчуванням)

        // Подія за стандартним шаблоном .NET
        public event EventHandler<StatusChangedEventArgs<T>>? StatusChanged;

        public void Add(T item)
        {
            _items.Add(item);
        }

        public bool AdvanceStatus(string trackingNumber)
        {
            // Використання делегата Predicate<T> у методі Find
            T? item = _items.Find(x => x.TrackingNumber == trackingNumber);

            if (item == null) return false;

            if (item.Status == ShipmentStatus.Received)
            {
                return false; // Вже отримано, далі статус не змінюється
            }

            ShipmentStatus oldStatus = item.Status;
            item.Status = (ShipmentStatus)((int)item.Status + 1); // Перехід на наступний статус

            // Спричиняємо подію
            OnStatusChanged(new StatusChangedEventArgs<T>(item, oldStatus, item.Status));
            return true;
        }

        public decimal GetCost(T item)
        {
            // Якщо _tariff задано, виконуємо його, інакше — логіка за замовчуванням
            return _tariff?.Invoke(item) ?? (item.WeightKg * 40m);
        }

        public void ForEach(Action<T> action)
        {
            foreach (T item in _items)
            {
                action(item); // Виконання переданої дії
            }
        }

        public void SetTariff(Func<T, decimal>? tariff)
        {
            _tariff = tariff;
        }

        protected virtual void OnStatusChanged(StatusChangedEventArgs<T> e)
        {
            StatusChanged?.Invoke(this, e);
        }
    }

    // === 4. Головна програма (Program) ===
    class Program
    {
        // Історія статусів (для другого підписника)
        static readonly List<string> History = new();

        static void Main()
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;
            var tracker = new Tracker<Parcel>();

            // ПІДПИСНИКИ НА ПОДІЮ:
            // 1. Іменований метод (SMS повідомлення одержувачу)
            tracker.StatusChanged += SendSms;

            // 2. Лямбда-вираз (Запис в історію)
            tracker.StatusChanged += (sender, e) =>
            {
                History.Add($"[{DateTime.Now:HH:mm:ss}] {e.Shipment.TrackingNumber}: {e.OldStatus} -> {e.NewStatus}");
            };

            // Заповнення початкових даних наперед у коді
            tracker.Add(new Parcel("UA-1001", "Олена", 2.0m));
            tracker.Add(new Parcel("UA-1002", "Іван", 0.5m));
            tracker.Add(new Parcel("UA-1003", "Марія", 5.0m));

            bool isRunning = true;
            while (isRunning)
            {
                Console.WriteLine("\n=== Меню Відстеження Посилок ===");
                Console.WriteLine("0. Вихід");
                Console.WriteLine("1. Додати посилку");
                Console.WriteLine("2. Показати посилки");
                Console.WriteLine("3. Оновити статус посилки");
                Console.WriteLine("4. Обрати тариф");
                Console.WriteLine("5. Показати історію статусів");

                int choice = ReadInt("Ваш вибір: ", 0, 5);

                isRunning = choice switch
                {
                    1 => HandleAdd(tracker),
                    2 => HandleShowAll(tracker),
                    3 => HandleAdvance(tracker),
                    4 => HandleChooseTariff(tracker),
                    5 => HandleShowHistory(),
                    0 => false,
                    _ => true
                };
            }
            Console.WriteLine("Програму завершено.");
        }

        // Обробник події — іменований метод
        static void SendSms(object? sender, StatusChangedEventArgs<Parcel> e)
        {
            Console.ForegroundColor = ConsoleColor.Green;
            Console.WriteLine($"\n[SMS для {e.Shipment.Recipient}]: Посилка {e.Shipment.TrackingNumber} перейшла у статус {e.NewStatus}.");

            // Завдання за бажанням: генерація коду і вартості при прибутті (Arrived)
            if (e.NewStatus == ShipmentStatus.Arrived && sender is Tracker<Parcel> tracker)
            {
                decimal cost = tracker.GetCost(e.Shipment);
                int code = Random.Shared.Next(1000, 10000);
                Console.WriteLine($"[SMS для {e.Shipment.Recipient}]: До сплати {cost:F2} грн. Код отримання: {code}");
            }
            Console.ResetColor();
        }

        // --- Методи для пунктів меню ---

        static bool HandleAdd(Tracker<Parcel> tracker)
        {
            string number = ReadNonEmpty("Номер посилки (напр. UA-1004): ");
            string recipient = ReadNonEmpty("Ім'я одержувача: ");
            decimal weight = ReadDecimal("Вага (кг): ", 0.1m);

            tracker.Add(new Parcel(number, recipient, weight));
            Console.WriteLine("Посилку успішно додано.");
            return true;
        }

        static bool HandleShowAll(Tracker<Parcel> tracker)
        {
            Console.WriteLine("\n--- Список посилок ---");
            // Лямбда-вираз для Action<T> у ForEach
            tracker.ForEach(p =>
            {
                decimal cost = tracker.GetCost(p);
                Console.WriteLine($"{p.TrackingNumber} (Одержувач: {p.Recipient}) - Статус: {p.Status} | Вага: {p.WeightKg} кг | Вартість: {cost:F2} грн");
            });
            return true;
        }

        static bool HandleAdvance(Tracker<Parcel> tracker)
        {
            string number = ReadNonEmpty("Введіть номер посилки: ");
            if (!tracker.AdvanceStatus(number))
            {
                Console.WriteLine("Увага: Посилку не знайдено або вона вже у кінцевому статусі (Received).");
            }
            return true;
        }

        static bool HandleChooseTariff(Tracker<Parcel> tracker)
        {
            Console.WriteLine("Оберіть тариф:");
            Console.WriteLine("0 - Стандартний (40 грн/кг)");
            Console.WriteLine("1 - Фіксований (70 грн)");
            Console.WriteLine("2 - Експрес (100 грн + 60 грн/кг)");
            Console.WriteLine("3 - Акційний (-20% від стандарту)");

            // Зміна поведінки через замикання лямбда-виразів
            Func<Parcel, decimal>? tariff = ReadInt("Ваш вибір: ", 0, 3) switch
            {
                1 => p => 70m,
                2 => p => 100m + (p.WeightKg * 60m),
                3 => p => (p.WeightKg * 40m) * 0.8m,
                _ => null // Скидання до стандартного (за замовчуванням)
            };

            tracker.SetTariff(tariff);
            Console.WriteLine("Тариф успішно оновлено.");
            return true;
        }

        static bool HandleShowHistory()
        {
            Console.WriteLine("\n--- Історія статусів ---");
            if (History.Count == 0)
            {
                Console.WriteLine("Історія порожня.");
            }
            else
            {
                foreach (var record in History)
                {
                    Console.WriteLine(record);
                }
            }
            return true;
        }

        // --- Допоміжні методи введення ---

        static string ReadNonEmpty(string prompt)
        {
            while (true)
            {
                Console.Write(prompt);
                string? input = Console.ReadLine();
                if (!string.IsNullOrWhiteSpace(input)) return input.Trim();
                Console.WriteLine("Помилка: рядок не може бути порожнім.");
            }
        }

        static int ReadInt(string prompt, int min, int max)
        {
            while (true)
            {
                Console.Write(prompt);
                if (int.TryParse(Console.ReadLine(), out int value) && value >= min && value <= max)
                    return value;
                Console.WriteLine($"Помилка: введіть ціле число від {min} до {max}.");
            }
        }

        static decimal ReadDecimal(string prompt, decimal min)
        {
            while (true)
            {
                Console.Write(prompt);
                if (decimal.TryParse(Console.ReadLine(), out decimal value) && value >= min)
                    return value;
                Console.WriteLine($"Помилка: введіть число не менше {min}.");
            }
        }
    }
}
